msgid "Weblate features"
msgstr "ຄຸນສົມບັດ Weblate"

msgid ""
"As a feature rich computer aided translation tool, Weblate saves both "
"developers and translators time. Make your users happier!"
msgstr ""
"ໃນຖານະທີ່ເປັນເຄື່ອງມືຊ່ວຍແປທີ່ມີຄຸນສົມບັດຫຼາກຫຼາຍ, Weblate ຊ່ວຍປະຢັດເວລາທັງນັກພັດທະນາ ແລະ ນັກແປ. "
"ເຮັດໃຫ້ຜູ້ໃຊ້ຂອງເຈົ້າມີຄວາມສຸກຫຼາຍຂຶ້ນ!"

msgid ""
"Browse the <a href=\"https://docs.weblate.org/\">documentation</a> to learn "
"more."
msgstr "ຊອກຫາ <a href=\"https://docs.weblate.org/\">ເອກະສານ</a> ເພື່ອຮຽນຮູ້ເພີ່ມເຕີມ."

msgid "Easy to use interface"
msgstr "ອິນເຕີເຟດທີ່ໃຊ້ງານງ່າຍ"

msgid "Weblate screenshot"
msgstr "ພາບໜ້າຈໍ Weblate"

msgid "Customizable quality checks"
msgstr "ການກວດສອບຄຸນນະພາບທີ່ປັບແຕ່ງໄດ້"

msgid "Detailed context"
msgstr "ບໍລິບົດລະອຽດ"

msgid ""
"Translators are provided detailed translation context, from translation "
"files, or data enriched within Weblate."
msgstr "ນັກແປໄດ້ຮັບບໍລິບົດການແປທີ່ລະອຽດ, ຈາກໄຟລ໌ການແປ, ຫຼື ຂໍ້ມູນທີ່ເພີ່ມເຕີມພາຍໃນ Weblate."

msgid "Fluent communication"
msgstr "ການສື່ສານທີ່ລ່ຽນໄຫຼ"

msgid "All translations are tracked and can be commented."
msgstr "ການແປທັງໝົດຖືກຕິດຕາມ ແລະ ສາມາດສະແດງຄວາມຄິດເຫັນໄດ້."

msgid "Access Control"
msgstr "ການຄວບຄຸມການເຂົ້າເຖິງ"

msgid "Fine-tune access rights to fit your environment."
msgstr "ປັບແຕ່ງສິດການເຂົ້າເຖິງໃຫ້ເໝາະສົມກັບສະພາບແວດລ້ອມຂອງເຈົ້າ."

msgid "Smart Notifications"
msgstr "ການແຈ້ງເຕືອນອັດສະລິຍະ"

msgid ""
"Translators can be notified of new strings to translate or other events."
msgstr "ນັກແປສາມາດໄດ້ຮັບການແຈ້ງເຕືອນກ່ຽວກັບຂໍ້ຄວາມໃໝ່ເພື່ອແປ ຫຼື ເຫດການອື່ນໆ."

msgid "Integration API"
msgstr "API ສຳລັບການເຊື່ອມຕໍ່"

msgid "Integrate Weblate with third-party services."
msgstr "ເຊື່ອມຕໍ່ Weblate ກັບບໍລິການພາຍນອກ."

msgid "Multiple File Formats"
msgstr "ຮູບແບບໄຟລ໌ທີ່ຫຼາກຫຼາຍ"

msgid ""
"Use any common file localization format, like gettext, JSON, XLIFF or "
"resource strings, etc."
msgstr ""
"ໃຊ້ຮູບແບບການປັບແຕ່ງພາສາທົ່ວໄປ, ເຊັ່ນ gettext, JSON, XLIFF ຫຼື resource strings, ແລະ "
"ອື່ນໆ."

msgid "Branch Support"
msgstr "ການຮອງຮັບ Branch"

msgid ""
"Handle different translation versions by pushing them automatically to "
"different branches."
msgstr ""
"ຈັດການເວີຊັນການແປທີ່ແຕກຕ່າງກັນໂດຍການພັຊ (push) ພວກມັນໂດຍອັດຕະໂນມັດໄປຍັງ branch ທີ່ແຕກຕ່າງກັນ."

msgid "Translation Context"
msgstr "ບໍລິບົດການແປ"

msgid ""
"Description, nearby strings, images, related source code and glossary entries"
"—for every string."
msgstr ""
