msgstr "חסרה לך <strong>תכונה</strong> או שמעניין אותך לשנות משהו?"

#, python-format
msgid "Suggest your change in the <a href=\"%(url)s\">GitHub issues</a>."
msgstr "ניתן להציע הצעות ב<a href=\"%(url)s\">עוקב התקלות ב־GitHub</a>."

msgid "<strong>Source code</strong> related questions?"
msgstr "שאלות שקשורות ב<strong>קוד המקור</strong>?"

#, python-format
msgid ""
"Please consult the <a href=\"%(url)s\">contributor documentation</a> to find "
"the most common topics."
msgstr ""
