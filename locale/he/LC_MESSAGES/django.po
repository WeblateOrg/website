msgstr ""
"יש מגוון דרכים בהן ניתן לסייע בפיתוח Weblate. כמו לדבר עליו עם המכרים שלך."

msgid "View sources"
msgstr "צפייה במקורות"

msgid "Translate the app"
msgstr "תרגום היישום"

msgid "Found a <strong>bug</strong> in Weblate?"
msgstr "מצאת <strong>תקלה</strong> ב־Weblate?"

#, python-format
msgid ""
"In case it is sensitive or a <strong>security issue</strong>, please report "
