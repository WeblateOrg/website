msgstr ""
"אפשר לסייע בתיקון ובהצעת בקשות דחיפה שאינן קוד על ידי הצטרפות לצוות הסוקרים."

msgid "<strong>Financial support</strong> is always put to good use."
msgstr "<strong>התמיכה הכלכלית</strong> תמיד משמשת למטרה טובה."

msgid "Please open the donation page for options on how to donate."
msgstr "נא לפתוח את עמוד התרומה לצפייה באפשרויות השונות לתרומה."

