msgstr "GitHub problemi"

msgid "Have a <strong>patch</strong> that fixes a bug?"
msgstr "Imaš <strong>zakrpu</strong> koja popravlja grešku?"

#, python-format
msgid "Open a new <a href=\"%(url)s\">GitHub pull request</a> with the patch."
msgstr ""
"Otvori novi <a href=\"%(url)s\">GitHub zahtjev za preuzimanje</a> sa zakrpom."

msgid ""
"Ensure the pull request description clearly describes the problem and "
"solution. Include the relevant issue number if applicable."
msgstr ""
"Osiguraj, da opis zahtjeva za preuzimanje jasno opisuje problem i rješenje. "
"Uključi odgovarajući broj problema, ako postoji."

msgid "Open a pull request"
msgstr "Otvori zahtjev za preuzimanje"

msgid "Missing a <strong>feature</strong> or want to change something?"
msgstr "Nedostaje ti <strong>funkcija</strong> ili želiš nešto promijeniti?"

#, python-format
msgid "Suggest your change in the <a href=\"%(url)s\">GitHub issues</a>."
msgstr "Predloži promjenu u <a href=\"%(url)s\">GitHub problemima</a>."

msgid "<strong>Source code</strong> related questions?"
msgstr "Pitanje u vezi s <strong>izvornim kodom</strong>?"

#, python-format
msgid ""
"Please consult the <a href=\"%(url)s\">contributor documentation</a> to find "
"the most common topics."
