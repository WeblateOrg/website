#, python-format
msgid ""
"VIES is temporarily unavailable. The invoice was issued using the VAT "
"validation from %(validated)s."
msgstr ""
"VIES geçici olarak kullanılamıyor. Fatura, %(validated)s üzerinden KDV "
"doğrulaması ile hazırlanmıştır."

msgid ""
"Select the paid invoice for the same customer and correct the full remaining "
"amount."
msgstr ""
"Aynı müşteri için ödenen faturayı seçin ve kalan tutarın tümünü düzeltin."

msgid ""
"This legacy invoice cannot be corrected because its rounding differs from "
"current invoice calculations."
msgstr ""
"Bu eski fatura, yuvarlanmış fatura hesaplamasından farklı olduğundan "
"düzeltilemez."

msgid "This request has already been used."
msgstr "Bu istek zaten kullanılmış."

msgid "Choose a positive amount within the remaining invoice amount."
msgstr "Kalan fatura tutarı içinden pozitif bir tutar seçin."

msgid "A correction reason and explanation are required."
msgstr "Bir düzeltme nedeni ve açıklama yazılması zorunludur."

msgid "Correction dates cannot precede the original invoice dates."
msgstr "Düzeltme tarihleri özgün fatura tarihlerinden önce olamaz."

msgid "Payments can only be cancelled for duplicate invoices."
msgstr "Ödemeler yalnızca yinelenen faturalar için iptal edilebilir."

msgid "Resolve the pending payment before issuing a correction."
msgstr "Düzeltme yapmadan önce bekleyen ödemeyi çözümleyin."

msgid ""
"Review the related payments and select the checkbox to mark them as "
"cancelled."
msgstr ""
"İlgili ödemeleri gözden geçirin ve iptal edilmiş olarak işaretlemek için "
"kutuya tıklayın."

msgid "Only paid invoices can be refunded."
msgstr "Geri ödemeler yalnızca ödenmiş faturalar için yapılabilir."

msgid "Only duplicate corrections can reference a replacement invoice."
msgstr ""
"Yalnızca yinelenen düzeltmeler bir değiştirme faturasına referans verebilir."

msgid "The correction amount excluding VAT cannot exceed 99,999.99."
msgstr "KDV hariç düzeltme tutarı 99.999.99 değerini aşamaz."

msgid "Only positive final invoices can be marked uncollectible."
msgstr "Yalnızca olumlu son faturalar tahsil edilemez olarak işaretlenebilir."

msgid "This invoice has already been settled."
msgstr "Bu fatura zaten ödenmiş."

msgid "An internal explanation is required."
msgstr "Bir iç açıklama yazılması zorunludur."

msgid ""
"The customer's VAT ID could not be validated, so the invoice was not issued. "
"Update the customer data or try again later."
msgstr ""
"Müşterinin KDV Kimliği doğrulanamadığı için fatura hazırlanmadı. Müşteri "
"verilerini güncelleyin veya bir süre sonra yeniden deneyin."

